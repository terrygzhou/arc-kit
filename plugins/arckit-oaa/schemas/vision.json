{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arckit.org/schemas/architecture/vision.json",
  "title": "ArcKit OAA — Architecture Vision (vision.yaml)",
  "description": "Sprint 0 (ADM-P + A) vision document: scope, constraints, stakeholders, success criteria. Shared between /arckit:oaa-adm-lite, /arckit:product-architecture, /arckit:agile-strategy, /arckit:agile-security, /arckit:agile-governance and the traditional /arckit:adm-preliminary track. Structure source: templates/oaa-adm-lite-template.md §Sprint 0.",
  "type": "object",
  "required": ["vision"],
  "additionalProperties": false,
  "properties": {
    "vision": {
      "type": "object",
      "required": ["scope"],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "object",
          "required": ["ai_workload_type"],
          "additionalProperties": false,
          "properties": {
            "ai_workload_type": {
              "type": "string",
              "enum": [
                "RAG pipeline",
                "Agent orchestration",
                "LLM serving",
                "RAG pipeline + agent orchestration",
                "Agent orchestration + RAG + model serving"
              ]
            },
            "use_cases": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "data_classification": {
              "type": "string",
              "enum": ["public", "internal", "confidential", "regulated"]
            },
            "user_count": { "type": "integer", "minimum": 1 },
            "latency_requirement_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "budget_aud": { "type": "number", "minimum": 0 },
            "timeline_weeks": { "type": "integer", "minimum": 1 },
            "infrastructure": {
              "type": "string",
              "enum": ["on_premise", "private_cloud", "hybrid", "multi-region"]
            },
            "jurisdiction": {
              "type": "string",
              "enum": ["AU", "EU", "APAC", "US", "multi"]
            }
          }
        },
        "stakeholders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "concern"],
            "additionalProperties": false,
            "properties": {
              "role": { "type": "string" },
              "concern": { "type": "string" },
              "success_metric": { "type": "string" }
            }
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric"],
            "additionalProperties": false,
            "properties": {
              "metric": { "type": "string" },
              "target_ms": { "type": "number", "minimum": 0 },
              "target_percent": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "regulatory_controls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risk_profile": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["risk", "mitigation"],
            "additionalProperties": false,
            "properties": {
              "risk": { "type": "string" },
              "mitigation": { "type": "string" }
            }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topology": {
              "type": "string",
              "enum": [
                "air-gapped",
                "network-isolated",
                "network-isolated-per-region",
                "cloud_vpc"
              ]
            }
          }
        }
      }
    }
  }
}
