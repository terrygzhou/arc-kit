{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arckit.org/schemas/architecture/implementation-strategy.json",
  "title": "ArcKit OAA — Implementation Strategy (implementation-strategy.yaml)",
  "description": "Sprint 3 (ADM-E + F) implementation waves and migration strategy. Shared between the OAA track and the traditional /arckit:transition-architecture track. Structure source: templates/oaa-adm-lite-template.md §Sprint 3.",
  "type": "object",
  "required": ["waves"],
  "additionalProperties": false,
  "properties": {
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "duration_weeks", "work_packages"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "duration_weeks": { "type": "number", "minimum": 1 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "work_packages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "type", "effort_person_weeks", "assignee_role"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "type": {
                  "type": "string",
                  "enum": ["infrastructure", "application", "data", "security", "governance"]
                },
                "effort_person_weeks": { "type": "number", "minimum": 0.5 },
                "assignee_role": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["big_bang", "incremental", "parallel_run"]
        },
        "cutover_window": { "type": "string" },
        "rollback_trigger": { "type": "string" }
      }
    }
  }
}
