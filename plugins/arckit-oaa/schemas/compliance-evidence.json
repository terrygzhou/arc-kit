{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arckit.org/schemas/architecture/compliance-evidence.json",
  "title": "ArcKit OAA — Sprint Compliance Evidence (compliance-evidence-sprint-N.yaml)",
  "description": "Standardized per-sprint compliance evidence format: regulatory control status with verification artifacts, scan summary (SAST, secrets, dependencies, compliance), and next-sprint security goals. Shared between /arckit:agile-security and /arckit:agile-governance; feeds governance-report.yaml compliance monitoring. Structure source: templates/agile-security-template.md §Pillar 3 + templates/agile-governance-template.md §4.",
  "type": "object",
  "required": ["sprint", "controls"],
  "additionalProperties": false,
  "properties": {
    "sprint": { "type": "integer", "minimum": 1 },
    "jurisdiction": {
      "type": "string",
      "enum": ["AU", "EU", "APAC", "US", "multi"]
    },
    "generated_at": { "type": "string" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control", "status"],
        "additionalProperties": false,
        "properties": {
          "control": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pass", "gap", "pending"]
          },
          "verification": { "type": "string" },
          "pending_items": {
            "type": "array",
            "items": { "type": "string" }
          },
          "artifact": { "type": "string" },
          "verified_at": { "type": "string" }
        }
      }
    },
    "scan_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sast": {
          "type": "object",
          "required": ["status", "tool"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string" },
            "critical_findings": { "type": "integer", "minimum": 0 },
            "high_findings": { "type": "integer", "minimum": 0 },
            "tool": { "type": "string" }
          }
        },
        "secrets": {
          "type": "object",
          "required": ["status", "tool"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string" },
            "findings": { "type": "integer", "minimum": 0 },
            "tool": { "type": "string" }
          }
        },
        "dependencies": {
          "type": "object",
          "required": ["status", "tool"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string" },
            "critical_findings": { "type": "integer", "minimum": 0 },
            "high_findings": { "type": "integer", "minimum": 0 },
            "medium_findings": { "type": "integer", "minimum": 0 },
            "tool": { "type": "string" }
          }
        },
        "compliance": {
          "type": "object",
          "required": ["status", "tool"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string" },
            "controls_checked": { "type": "integer", "minimum": 0 },
            "controls_passed": { "type": "integer", "minimum": 0 },
            "controls_gapped": { "type": "integer", "minimum": 0 },
            "tool": { "type": "string" }
          }
        }
      }
    },
    "next_sprint_goals": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
