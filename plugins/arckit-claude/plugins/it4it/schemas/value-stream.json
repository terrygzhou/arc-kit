{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arckit-it4it/schemas/value-stream.json",
  "title": "IT4IT Value Stream",
  "description": "One value stream of the IT4IT Value Network (S261, Ch. 5). Reference-only — S261 is a snapshot, not an approved standard.",
  "type": "object",
  "required": ["id", "stream", "trigger", "stakeholder", "stages"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Document ID, e.g. ARC-002-ITVS-001-v1.0"
    },
    "stream": {
      "type": "string",
      "enum": ["Evaluate", "Explore", "Integrate", "Deploy", "Publish", "Consume", "Operate"],
      "description": "The S261 value stream this artefact covers"
    },
    "scenario": {
      "type": "string",
      "description": "Scenario from the S261 catalog covered by this artefact"
    },
    "trigger": {
      "type": "object",
      "required": ["condition"],
      "properties": {
        "condition": { "type": "string" },
        "frequency": { "type": "string" },
        "source_stream": {
          "type": "string",
          "description": "Upstream stream that triggers this one (if any)"
        }
      }
    },
    "stakeholder": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "accountable_role": { "type": "string" },
        "contributing_roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered stage sequence for this stream",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "functional_components": { "type": "array", "items": { "type": "string" } },
          "kdo_in": { "type": "array", "items": { "type": "string" } },
          "kdo_out": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "cross_stream": {
      "type": "array",
      "description": "Inbound/outbound handoff KDOs and their contracts",
      "items": {
        "type": "object",
        "required": ["direction", "stream", "handoff_kdo"],
        "properties": {
          "direction": { "type": "string", "enum": ["inbound", "outbound"] },
          "stream": { "type": "string" },
          "handoff_kdo": { "type": "string" },
          "contract": { "type": "string", "description": "Cardinality + system-of-record obligation" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": { "type": "string" },
      "description": "S261 catalog scenarios covered"
    },
    "system_of_record": {
      "type": "object",
      "description": "KDO -> authoritative system map",
      "additionalProperties": { "type": "string" }
    },
    "conformance_notes": {
      "type": "string",
      "description": "Must state S261 is referenced as a reference architecture; no conformance claim"
    }
  }
}
