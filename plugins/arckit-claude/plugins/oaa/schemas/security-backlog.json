{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arckit.org/schemas/architecture/security-backlog.json",
  "title": "ArcKit OAA — Security Backlog (security-backlog-sprint-N.yaml)",
  "description": "Per-sprint security backlog: component risk classification, security stories (epic categories: data protection, authentication/authorization, encryption, monitoring/observability, incident response, compliance reporting), and security debt. O-AA specific; feeds ADM-E security prioritization. Structure source: templates/agile-security-template.md §Sprint Security Backlog Template.",
  "type": "object",
  "required": ["sprint", "risk_classification", "security_stories"],
  "additionalProperties": false,
  "properties": {
    "sprint": { "type": "integer", "minimum": 1 },
    "risk_classification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "risk_level", "threats"],
        "additionalProperties": false,
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "risk_level": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "threats": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "security_stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "risk", "category", "control", "acceptance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "risk": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": { "type": "string", "minLength": 1 },
          "control": { "type": "string", "minLength": 1 },
          "compliance": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "security_debt": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "risk", "target_sprint"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "risk": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "target_sprint": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
