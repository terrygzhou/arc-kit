{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arckit.org/schemas/architecture/product-architecture.json",
  "title": "ArcKit OAA — Product Architecture (product-architecture.yaml)",
  "description": "Product as organising principle (Axiom 15): team composition, architecture backlog, release roadmap, value streams, embedded compliance. Shared between /arckit:product-architecture and /arckit:agile-strategy. Structure source: templates/product-architecture-template.md.",
  "type": "object",
  "required": ["product"],
  "additionalProperties": false,
  "properties": {
    "product": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "mission": { "type": "string" }
      }
    },
    "team": {
      "type": "object",
      "required": ["roles"],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "responsibility"],
            "additionalProperties": false,
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "responsibility": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "backlog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "priority"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["capability", "feature", "technical", "compliance"]
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "sprint": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "compliance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["regulation", "control"],
              "additionalProperties": false,
              "properties": {
                "regulation": { "type": "string" },
                "control": { "type": "string" },
                "status": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "roadmap": {
      "type": "object",
      "required": ["releases"],
      "additionalProperties": false,
      "properties": {
        "versioning": {
          "type": "string",
          "enum": ["semantic", "calendar"]
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["version", "name", "outcome"],
            "additionalProperties": false,
            "properties": {
              "version": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "target_date": { "type": "string" },
              "outcome": { "type": "string", "minLength": 1 },
              "architecture_scope": {
                "type": "array",
                "items": { "type": "string" }
              },
              "features": {
                "type": "array",
                "items": { "type": "string" }
              },
              "compliance_milestones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["milestone", "regulation", "status"],
                  "additionalProperties": false,
                  "properties": {
                    "milestone": { "type": "string" },
                    "regulation": { "type": "string" },
                    "status": {
                      "type": "string",
                      "enum": ["planned", "in_progress", "implemented"]
                    }
                  }
                }
              }
            }
          }
        },
        "architecture_evolution": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase", "focus", "principle"],
            "additionalProperties": false,
            "properties": {
              "phase": { "type": "string" },
              "focus": { "type": "string" },
              "principle": { "type": "string" }
            }
          }
        }
      }
    },
    "value_streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "owner"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "owner": { "type": "string" },
                "duration_hours": { "type": "number", "minimum": 0 },
                "type": {
                  "type": "string",
                  "enum": ["event", "analysis", "work", "verification", "execution"]
                },
                "output": { "type": "string" }
              }
            }
          },
          "total_touch_time_hours": { "type": "number", "minimum": 0 },
          "total_wait_time_hours": { "type": "number", "minimum": 0 },
          "total_lead_time_hours": { "type": "number", "minimum": 0 },
          "efficiency_percent": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "compliance": {
      "type": "object",
      "required": ["jurisdiction", "regulations"],
      "additionalProperties": false,
      "properties": {
        "jurisdiction": {
          "type": "string",
          "enum": ["AU", "EU", "APAC", "US", "multi"]
        },
        "regulations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "scope": { "type": "string" },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "description", "status"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "description": { "type": "string" },
                    "features": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "status": {
                      "type": "string",
                      "enum": ["planned", "in_progress", "implemented"]
                    }
                  }
                }
              }
            }
          }
        },
        "feature_compliance_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature", "compliance"],
            "additionalProperties": false,
            "properties": {
              "feature": { "type": "string" },
              "name": { "type": "string" },
              "compliance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["regulation", "control", "status"],
                  "additionalProperties": false,
                  "properties": {
                    "regulation": { "type": "string" },
                    "control": { "type": "string" },
                    "status": {
                      "type": "string",
                      "enum": ["planned", "in_progress", "implemented"]
                    },
                    "evidence": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
